# Copy to .env and fill in. Never commit .env.

# Each person uses their own key.
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Health API (Fitbit) OAuth
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Absolute path to your local credentialed mcPHASES copy. Keep it outside the repo or under data/raw/.
MCPHASES_DIR=
