# Copy to .env and fill in. Never commit .env.

# Each person uses their own key.
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Health API (Fitbit), via the course OAuth helper (see BINF 4070 Lab 3).
# The helper gives you this matching pair. Never paste them into chats or AI tools.
GOOGLE_HEALTH_REFRESH_TOKEN=
GOOGLE_HEALTH_HELPER_TOKEN=

# Your own mcPHASES download (PhysioNet restricted access). It must live here: Claude is denied this path.
MCPHASES_DIR=data/raw/mcphases
