# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets. Google Health tokens live in .env; the patterns below catch stray credential files.
.env
token*.json
credentials*.json
client_secret*.json
token.pickle
.secrets/

# Data: restricted-access (mcPHASES/PhysioNet) and real personal data never get committed.
# Only data/README.md and data/synthetic/ are tracked.
data/*
!data/README.md
!data/synthetic/

# Models and generated artifacts
models/
*.pt
*.pkl
*.joblib
*.faiss
*.index

# Notebooks: commit code, not outputs
.ipynb_checkpoints/

# Local working files
_inputs/
.DS_Store
.streamlit/secrets.toml
